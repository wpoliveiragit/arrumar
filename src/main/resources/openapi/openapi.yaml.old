#####
#####
#####
#####
openapi: 3.0.0
info:
  version: 1.0.0
  title: Gestão de metadados de Personagem
  termsOfService: http://localhost:8080/docs/terms.html # Add em 'resources/static/docs/terms.html'
  contact:
    name: Pegasus SA
    email: suporte@pegasus.com.br
    url: http://localhost:8080/pegasus/website.html # Add em 'resources/static/pegasus/website.html'
  license:
    name: Licença MIT
    url: http://localhost:8080/docs/license.html # Add em 'resources/static/docs/license.html'
  description: |-
    Esta API contempla o gerenciamento de metadados de um jogo de RPG separados por tags.
    
    Sobre a API:
    - Solicitações: Via localhost
    - Acesse: http://localhost:8080/swagger-ui/index.html
    
    A API pode ser usada para ter controle de metados de persob:
    - Personagem
    - Raça
    - Classe

servers:
  - url: http://localhost:8080
    description: Servidor local de desenvolvimento

tags:
  - name: game-character
    description: Operações CRUD de Personagens → [ getAllPage - getOne - create - update - delete ]
  - name: game-race
    description: Operações CRUD de Raça → [ getAllPage - getOne - create - update - delete ]
  - name: game-class
    description: Operações CRUD de Classe → [ getAllPage - getOne - create - update - delete ]

paths:

  /GameCharacter:
    parameters:
      - $ref: '#/components/parameters/_header_x_pegasus_client_id'

    get:
      tags: [ game-character ]
      operationId: game-character-find-all-page
      summary: Listar elementos com paginação.
      description: Retorna uma lista paginada de elementos disponíveis.
      parameters:
        - $ref: '#/components/parameters/_query_offset'
        - $ref: '#/components/parameters/_query_limit'
      responses:
        '200':
          description: Retorna a página solicitada.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameCharacterFindAllPageResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

    post:
      tags: [ game-character ]
      operationId: game-character-create
      summary: Criar novo elemento
      description: Cria um novo elemento no sistema com base nos dados informados na requisição.
      requestBody:
        description: Os dados de criação do elemento
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GameCharacterCreateBodyType'
      responses:
        '201':
          description: O elemento criado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameCharacterCreateResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

  /GameCharacter/{game_Character_id}:
    parameters:
      - $ref: "#/components/parameters/_header_x_pegasus_client_id"
      - $ref: '#/components/parameters/_path_game_character_id'

    get:
      tags: [ game-character ]
      operationId: game-character-find-by-id
      summary: Buscar elemento por ID.
      description: Retorna os dados completos de um elemento específico com base em seu identificador único.
      responses:
        '200':
          description: O elemento solicitado solicitado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameCharacterFindByIdResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'
        default:
          description: Unexpected error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InternalServerErrorResponseType'

    put:
      tags: [ game-character ]
      operationId: game-character-update
      summary: Atualiza um elemento do sistema
      description: Atualiza os dados de um elemento do sistema, identificado pelo seu ID
      requestBody:
        description: Os dados da atualização do elemento.
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GameCharacterUpdateBodyType'
      responses:
        '200':
          description: O elemento atualizado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameCharacterUpdateResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

    delete:
      tags: [ game-character ]
      operationId: game-character-excluir
      summary: Excluir um elemento do sistema
      description: Remove um elemento do sistema de forma permanente, com base em seu identificador.
      responses:
        '204':
          description: ok → sem retorno.
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'


  /GameRace:
    parameters:
      - $ref: '#/components/parameters/_header_x_pegasus_client_id'

    get:
      tags: [ game-race ]
      operationId: game-race-find-all-page
      summary: Listar elementos com paginação.
      description: Retorna uma lista paginada de elementos disponíveis.
      parameters:
        - $ref: '#/components/parameters/_query_offset'
        - $ref: '#/components/parameters/_query_limit'
      responses:
        '200':
          description: Retorna a página solicitada.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameRaceFindAllPageResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

    post:
      tags: [ game-race ]
      operationId: game-race-create
      summary: Criar novo elemento
      description: Cria um novo elemento no sistema com base nos dados informados na requisição.
      requestBody:
        description: Os dados de criação do elemento
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GameRaceCreateBodyType'
      responses:
        '201':
          description: O elemento criado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameRaceCreateResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

  /GameRace/{game_race_id}:
    parameters:
      - $ref: "#/components/parameters/_header_x_pegasus_client_id"
      - $ref: '#/components/parameters/_path_game_race_id'

    get:
      tags: [ game-race ]
      operationId: game-race-find-by-id
      summary: Buscar elemento por ID.
      description: Retorna os dados completos de um elemento específico com base em seu identificador único.
      responses:
        '200':
          description: O elemento solicitado solicitado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameRaceFindByIdResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'
        default:
          description: Unexpected error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InternalServerErrorResponseType'

    put:
      tags: [ game-race ]
      operationId: game-race-update
      summary: Atualiza um elemento do sistema
      description: Atualiza os dados de um elemento do sistema, identificado pelo seu ID
      requestBody:
        description: description
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GameRaceUpdateBodyType'
      responses:
        '200':
          description: O elemento atualizado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameRaceUpdateResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

    delete:
      tags: [ game-race ]
      operationId: game-race-excluir
      summary: Excluir um elemento do sistema
      description: Remove um elemento do sistema de forma permanente, com base em seu identificador.
      responses:
        '204':
          description: ok → sem retorno.
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

  /GameClass:
    parameters:
      - $ref: '#/components/parameters/_header_x_pegasus_client_id'

    get:
      tags: [ game-class ]
      operationId: game-class-find-all-page
      summary: Listar elementos com paginação.
      description: Retorna uma lista paginada de elementos disponíveis.
      parameters:
        - $ref: '#/components/parameters/_query_offset'
        - $ref: '#/components/parameters/_query_limit'
      responses:
        '200':
          description: Retorna a página solicitada.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameClassFindAllPageResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

    post:
      tags: [ game-class ]
      operationId: game-class-create
      summary: Criar novo elemento
      description: Cria um novo elemento no sistema com base nos dados informados na requisição.
      requestBody:
        description: Os dados de criação do elemento
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GameClassCreateBodyType'
      responses:
        '201':
          description: O elemento criado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameClassCreateResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'

  /GameClass/{game_class_id}:
    parameters:
      - $ref: "#/components/parameters/_header_x_pegasus_client_id"
      - $ref: '#/components/parameters/_path_game_class_id'

    get:
      tags: [ game-class ]
      operationId: game-class-find-by-id
      summary: Buscar elemento por ID.
      description: Retorna os dados completos de um elemento específico com base em seu identificador único.
      responses:
        '200':
          description: O elemento solicitado solicitado.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GameClassFindByIdResponseType'
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'
        default:
          description: Unexpected error
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InternalServerErrorResponseType'

    put:
      tags: [ game-class ]
      operationId: game-class-update
      summary: Atualiza um elemento do sistema
      description: Atualiza os dados de um elemento do sistema, identificado pelo seu ID
      requestBody:
        description: description
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GameClassUpdateBodyType'
      responses:
        '200':
          description: O elemento atualizado.
          content:
