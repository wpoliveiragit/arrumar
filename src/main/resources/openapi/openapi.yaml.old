    delete:
      tags: [ game-class ]
      operationId: game-class-excluir
      summary: Excluir um elemento do sistema
      description: Remove um elemento do sistema de forma permanente, com base em seu identificador.
      responses:
        '204':
          description: ok → sem retorno.
        "400":
          $ref: '#/components/responses/bad-request-response'
        "404":
          $ref: '#/components/responses/not-found-response'
        "500":
          $ref: '#/components/responses/internal-server-error-response'


components:
  schemas:

    # [TYPE → FIELD]
    field-game-id:
      type: integer

    field-skills:
      type: array
      items:
        type: string

    field-game-name:
      type: string
      minLength: 5
      maxLength: 150

    # [ TYPE → REQUEST → GAME_CHARACTER → BODY]
    GameCharacterCreateBodyType:
      type: object
      properties:
        name:
          $ref: '#/components/schemas/field-game-name'
        classId:
          $ref: '#/components/schemas/field-game-id'
        raceId:
          $ref: '#/components/schemas/field-game-id'

    GameCharacterUpdateBodyType:
      type: object
      properties:
        name:
          $ref: '#/components/schemas/field-game-name'
        classId:
          $ref: '#/components/schemas/field-game-id'
        raceId:
          $ref: '#/components/schemas/field-game-id'

    # [ TYPE → REQUEST → GAME_CHARACTER → BODY]
    GameRaceCreateBodyType:
      type: object
      properties:
        name:
          $ref: '#/components/schemas/field-game-name'
        Id:
          $ref: '#/components/schemas/field-game-id'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    GameRaceUpdateBodyType:
      type: object
      properties:
        name:
          $ref: '#/components/schemas/field-game-name'
        Id:
          $ref: '#/components/schemas/field-game-id'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    # [ TYPE → REQUEST → GAME_CLASS → BODY]
    GameClassCreateBodyType:
      type: object
      properties:
        name:
          $ref: '#/components/schemas/field-game-name'
        Id:
          $ref: '#/components/schemas/field-game-id'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    GameClassUpdateBodyType:
      type: object
      properties:
        name:
          $ref: '#/components/schemas/field-game-name'
        Id:
          $ref: '#/components/schemas/field-game-id'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    # [ TYPE → RESPONSE → OBJECT]
    paginationType:
      type: object
      description: 'Modelo padrão para retorno de paginação'
      properties:
        page:
          description: 'página solicitada (base-0).'
          type: integer
          example: 10
        size:
          description: 'quantidade máxima de itens pos pagina.'
          type: integer
          example: 30
        totalElements:
          description: 'quantidade de registros na página.'
          type: integer
          format: int64
          example: 300
        totalPages:
          type: integer
          description: 'total de páginas (base-size).'
          example: 10
        hasPrevious:
          type: boolean
          description: 'existe próxima página?'
          example: true
        hasNext:
          type: boolean
          description: 'existe página anterior?'
          example: false

    # [ TYPE → RESPONSE → GAME_CHARACTER]
    GameCharacterFindAllPageResponseType:
      type: object
      properties:
        pagination:
          $ref: '#/components/schemas/paginationType'
        data:
          type: array
          items:
            $ref: '#/components/schemas/GameCharacterType'

    GameCharacterFindByIdResponseType:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/GameCharacterType'

    GameCharacterCreateResponseType:
      type: object
      description: 'descrição'
      properties:
        data:
          $ref: '#/components/schemas/GameCharacterType'

    GameCharacterUpdateResponseType:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/GameCharacterType'

    # [ TYPE → RESPONSE → GAME_RACE]
    GameRaceFindAllPageResponseType:
      type: object
      properties:
        pagination:
          $ref: '#/components/schemas/paginationType'
        data:
          type: array
          items:
            $ref: '#/components/schemas/GameRaceType'

    GameRaceFindByIdResponseType:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/GameRaceType'

    GameRaceCreateResponseType:
      type: object
      description: 'descrição'
      properties:
        data:
          $ref: '#/components/schemas/GameRaceType'

    GameRaceUpdateResponseType:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/GameRaceType'

    # [ TYPE → RESPONSE → GAME_CLASS]
    GameClassFindAllPageResponseType:
      type: object
      properties:
        pagination:
          $ref: '#/components/schemas/paginationType'
        data:
          type: array
          items:
            $ref: '#/components/schemas/GameClassType'

    GameClassFindByIdResponseType:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/GameClassType'

    GameClassCreateResponseType:
      type: object
      description: 'descrição'
      properties:
        data:
          $ref: '#/components/schemas/GameClassType'

    GameClassUpdateResponseType:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/GameClassType'

    # [ TYPE → RESPONSE → FAIL ]
    ExceptionResponseType:
      type: object
      description: Modelo padrão para erros
      properties:
        details:
          type: array
          items:
            type: string
          description: Detalhes do erro ocorrido.
          example: [ "Mensagem de erro 1" ]

    BadRequestType:
      allOf:
        - $ref: '#/components/schemas/ExceptionResponseType'
        - type: object
          example:
            details:
              - "O campo Name é obrigatório"
              - "O campo CharClassId é obrigatório"
              - "O campo CharRaceId é obrigatório"

    NotFoundResponseType:
      allOf:
        - $ref: '#/components/schemas/ExceptionResponseType'
        - type: object
          example:
            details:
              - "Character 123 não encontrado"

    ConflictResponseType:
      allOf:
        - $ref: '#/components/schemas/ExceptionResponseType'
        - type: object
          example:
            details:
              - "O Character 123 ja existe."

    InternalServerErrorResponseType:
      allOf:
        - $ref: '#/components/schemas/ExceptionResponseType'
        - type: object
          example:
            details:
              - "Banco de dados off-line"

    # [ TYPE → OBJECTS ]
    GameCharacterType:
      type: object
      properties:
        character:
          $ref: '#/components/schemas/IdNameType'
        characterRace:
          $ref: '#/components/schemas/IdNameType'
        characterClass:
          $ref: '#/components/schemas/IdNameType'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    IdNameType:
      type: object
      properties:
        id:
          $ref: '#/components/schemas/field-game-id'
        name:
          $ref: '#/components/schemas/field-game-name'


    GameRaceType:
      type: object
      properties:
        id:
          $ref: '#/components/schemas/field-game-id'
        name:
          $ref: '#/components/schemas/field-game-name'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    GameClassType:
      type: object
      properties:
        id:
          $ref: '#/components/schemas/field-game-id'
        name:
          $ref: '#/components/schemas/field-game-name'
        attributes:
          $ref: '#/components/schemas/AttributesType'

    AttributesType:
      type: object
      description: ''
      properties:
        life:
          type: integer
        damage:
          $ref: '#/components/schemas/DamageType'
        resistance:
          $ref: '#/components/schemas/ResistanceType'
        skills:
          $ref: '#/components/schemas/field-skills'

    DamageType:
      type: object
      description: ''
      properties:
        physical:
          type: integer
        magic:
          type: integer

    ResistanceType:
      type: object
      description: ''
      properties:
        physical:
          type: integer
        magic:
          type: integer

  parameters:

    # [ HEADER ] name → kebab-case ou x-prefix
    _header_x_pegasus_client_id:
      name: X-PEGASUS-CLIENT-ID
      in: header
      required: true
      description: Client ID header
      schema:
        type: string
      example: a1b30a84-7bf3-442e-84a0-e935d8163b5a

    # [ PATH ] name → camelCase ou snake_case
    _path_game_character_id:
      name: game_Character_id
      in: path
      required: true
      description: Identificador único do item
      schema:
        type: integer
        format: int64
        example: 1

    _path_game_race_id:
      name: game_race_id
      in: path
      required: true
      description: Identificador único do item
      schema:
        type: integer
        format: int64
        example: 1

    _path_game_class_id:
      name: game_class_id
      in: path
      required: true
      description: Identificador único do item
      schema:
        type: integer
        format: int64
        example: 1

    # [ QUERY ] name → underline inicial seguido de camelCase
    _query_limit:
      name: _limit
      in: query
      required: false
      allowEmptyValue: false
      description: 'description'
      schema:
        type: integer
        format: int32
      example: 10

    _query_offset:
      name: _offset
      in: query
      allowEmptyValue: false
      description: 'description'
      schema:
        type: integer
        format: int32
      example: 1

  responses:

    bad-request-response:
      description: Invalid input
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/BadRequestType'

    not-found-response:
      description: Element not found
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/NotFoundResponseType'

    conflict-response:
      description: Recurso não encontrado
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ConflictResponseType'

    internal-server-error-response:
      description: Erro interno no serviço
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/InternalServerErrorResponseType'

    default-error-response:
      description: Erro inesperado
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ExceptionResponseType'
#####
